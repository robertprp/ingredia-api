# Application
NODE_ENV=development
PORT=3000
APP_NAME="Your app name"

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
# Optional existing Better Auth user ID used to seed a sandbox Plus subscription.
BILLING_SEED_USER_ID=HDU2GaEgxfqgB0HfATDVbTItbdxAuhaj
BILLING_RETURN_URL_ORIGINS=http://localhost:8081
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
APPLE_PLUS_MONTHLY_PRODUCT_ID=
GOOGLE_PLAY_PLUS_MONTHLY_PRODUCT_ID=
# Trusted server-side verification services for StoreKit / Play Billing state.
APPLE_VERIFIER_URL=
APPLE_VERIFIER_API_KEY=
GOOGLE_PLAY_VERIFIER_URL=
GOOGLE_PLAY_VERIFIER_API_KEY=

# Google Cloud Vision OCR. Restrict the API key to vision.googleapis.com.
GOOGLE_CLOUD_PROJECT=ingredia-507308
GOOGLE_CLOUD_VISION_ENDPOINT=eu-vision.googleapis.com
GOOGLE_CLOUD_VISION_API_KEY=

# PPQ.ai-backed additive research job (pnpm enrich:additives)
PPQ_API_KEY=
PPQ_BASE_URL=https://api.ppq.ai
PPQ_MODEL=perplexity/sonar-pro
PPQ_TIMEOUT_MS=120000

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL at which this API is reachable. Do not add a trailing slash.
BETTER_AUTH_BASE_URL=http://localhost:3000

# Email verification and password reset
RESEND_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth Dash
# Required only while the Dash plugin is enabled in auth.schema.ts.
BETTER_AUTH_API_KEY=

# Apple OAuth
# Uncomment if the Apple provider is enabled in both Better Auth configurations.
# APPLE_CLIENT_ID=
