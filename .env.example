# Application
NODE_ENV=development
PORT=3000
APP_NAME=Ingredia

# PostgreSQL
# These POSTGRES_* values configure the local Docker Compose database.
POSTGRES_DB=ingredia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ingredia?schema=public

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL at which this API is reachable. Do not add a trailing slash.
BETTER_AUTH_BASE_URL=http://localhost:3000
# Required only while the Better Auth Dash plugin is enabled.
BETTER_AUTH_API_KEY=

# Transactional email (magic-link sign-in)
RESEND_API_KEY=

# Social authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=

# Google Cloud Vision OCR
# Restrict the API key to vision.googleapis.com and to the environments that use it.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_VISION_ENDPOINT=eu-vision.googleapis.com
GOOGLE_CLOUD_VISION_API_KEY=

# Billing
# Optional existing Better Auth user ID used to seed a local sandbox subscription.
BILLING_SEED_USER_ID=
# Comma-separated allowlist for Stripe return URLs.
BILLING_RETURN_URL_ORIGINS=http://localhost:8081
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
APPLE_PLUS_MONTHLY_PRODUCT_ID=
GOOGLE_PLAY_PLUS_MONTHLY_PRODUCT_ID=

# Trusted server-side verification services for StoreKit and Play Billing.
APPLE_VERIFIER_URL=
APPLE_VERIFIER_API_KEY=
GOOGLE_PLAY_VERIFIER_URL=
GOOGLE_PLAY_VERIFIER_API_KEY=

# PPQ.ai-backed additive research job (pnpm enrich:additives)
PPQ_API_KEY=
PPQ_BASE_URL=https://api.ppq.ai
PPQ_MODEL=perplexity/sonar-pro
PPQ_TIMEOUT_MS=120000
